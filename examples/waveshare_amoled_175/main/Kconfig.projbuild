menu "Masko demo"

config MASKO_PACK_IN_FLASH
    bool "Play the pack from the 'masko' flash partition"
    default y
    help
        The .mkpk is flashed into the 'masko' data partition and mmapped.
        Deselect to fall back to a pack compiled into the app image, which is
        convenient for quick iteration but bloats the binary.

config MASKO_PACK_MAX_FPS
    int "Frame rate cap"
    default 24
    range 1 60

config MASKO_SINGLE_PACK_BENCHMARK
    bool "Run a single-pack benchmark instead of the Kylo state graph"
    default n
    help
        Read one .mkpk from the masko partition and play it continuously.
        The demo reports playback metrics every 30 seconds. Useful for
        controlled comparisons of quality and frame-rate exports.

endmenu
